# Clickjacking Detection and Prevention Platform Configuration
# Copy this file to .env and adjust variables as needed

# Flask Secret Key for session signing and CSRF tokens (generate a strong key in production)
FLASK_SECRET_KEY=clickjack-def-sec-key-replace-in-production-2026-xyz

# Flask Environment: development, testing, production
FLASK_ENV=development

# Database configuration (defaults to instance/clickjack_defense.db)
DATABASE_PATH=clickjack_defense.db

# Scanner Security Limits
SCANNER_TIMEOUT_SECONDS=6
MAX_REDIRECTS=5
MAX_RESPONSE_SIZE_BYTES=524288  # 512 KB
RATE_LIMIT_PER_MINUTE=30

# Scanner Allowed Port List (default: 443 for HTTPS)
SCANNER_ALLOWED_PORTS=443

# Server Bind Configuration
HOST=127.0.0.1
PORT=5000
DEBUG=False
